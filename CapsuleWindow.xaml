<Window x:Class="DesktopCapsules.CapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{Binding CapsuleTitle}"
        Width="260"
        Height="184"
        MinWidth="188"
        MinHeight="40"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        SourceInitialized="Window_OnSourceInitialized"
        Loaded="Window_OnLoaded"
        Deactivated="Window_OnDeactivated"
        PreviewMouseDown="Window_OnPreviewMouseDown"
        DragEnter="Window_OnDragEnter"
        DragOver="Window_OnDragOver"
        Drop="Window_OnDrop">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#F5FBFF" />
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#CC25313B" />
            <Setter Property="BorderBrush" Value="#55FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid Background="Transparent"
                              Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}"
                              MinWidth="{TemplateBinding MinWidth}"
                              MinHeight="{TemplateBinding MinHeight}"
                              SnapsToDevicePixels="True">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    SnapsToDevicePixels="True" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.64" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#66FFFFFF" />
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#E1182028"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            CornerRadius="18"
            SnapsToDevicePixels="True">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Delete capsule" Click="DeleteCapsule_OnClick" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition x:Name="ContentRow" Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="Header"
                    Grid.Row="0"
                    Panel.ZIndex="3"
                    Background="#CC25313B"
                    CornerRadius="17,17,0,0"
                    MouseLeftButtonDown="Header_OnMouseLeftButtonDown"
                    MouseMove="Header_OnMouseMove"
                    MouseLeftButtonUp="Header_OnMouseLeftButtonUp">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="TitleText"
                                       HorizontalAlignment="Left"
                                       Text="{Binding CapsuleTitle}"
                                       Foreground="#F5FBFF"
                                       FontFamily="Segoe UI Semibold"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Cursor="IBeam"
                                       MouseLeftButtonDown="TitleText_OnMouseLeftButtonDown" />
                            <TextBox x:Name="TitleEditor"
                                     HorizontalAlignment="Left"
                                     Visibility="Collapsed"
                                     MinWidth="80"
                                     Padding="4,1"
                                     BorderThickness="0"
                                     Background="#F2FFFFFF"
                                     Foreground="#182028"
                                     FontFamily="Segoe UI Semibold"
                                     FontSize="13"
                                     KeyDown="TitleEditor_OnKeyDown"
                                     LostFocus="TitleEditor_OnLostFocus" />
                        </Grid>
                        <TextBlock Text="{Binding ItemCountText}"
                                   Foreground="#99D6E4F0"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="OptionsButton"
                            Width="24"
                            Height="24"
                            Margin="6,0,0,0"
                            Content="..."
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Options"
                            Click="OptionsButton_OnClick">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Background color">
                                    <MenuItem Header="Default" Click="DefaultBackgroundColor_OnClick" />
                                    <MenuItem Header="Custom..." Click="BackgroundColor_OnClick" />
                                </MenuItem>
                                <MenuItem Header="Border color">
                                    <MenuItem Header="Default" Click="DefaultBorderColor_OnClick" />
                                    <MenuItem Header="Custom..." Click="BorderColor_OnClick" />
                                </MenuItem>
                                <MenuItem Header="Header color">
                                    <MenuItem Header="Default" Click="DefaultHeaderColor_OnClick" />
                                    <MenuItem Header="Custom..." Click="HeaderColor_OnClick" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Roundness">
                                    <MenuItem Header="Default" Tag="18" Click="Roundness_OnClick" />
                                    <Separator />
                                    <MenuItem Header="Sharp" Tag="4" Click="Roundness_OnClick" />
                                    <MenuItem Header="Soft" Tag="12" Click="Roundness_OnClick" />
                                    <MenuItem Header="Round" Tag="20" Click="Roundness_OnClick" />
                                    <MenuItem Header="Pill" Tag="34" Click="Roundness_OnClick" />
                                </MenuItem>
                                <MenuItem Header="Background opacity">
                                    <MenuItem Header="Default" Tag="0.88" Click="BackgroundOpacity_OnClick" />
                                    <Separator />
                                    <MenuItem Header="10%" Tag="0.10" Click="BackgroundOpacity_OnClick" />
                                    <MenuItem Header="30%" Tag="0.30" Click="BackgroundOpacity_OnClick" />
                                    <MenuItem Header="50%" Tag="0.50" Click="BackgroundOpacity_OnClick" />
                                    <MenuItem Header="70%" Tag="0.70" Click="BackgroundOpacity_OnClick" />
                                    <MenuItem Header="88%" Tag="0.88" Click="BackgroundOpacity_OnClick" />
                                    <MenuItem Header="100%" Tag="1.00" Click="BackgroundOpacity_OnClick" />
                                </MenuItem>
                                <MenuItem Header="Header opacity">
                                    <MenuItem Header="Default" Tag="1.00" Click="HeaderOpacity_OnClick" />
                                    <Separator />
                                    <MenuItem Header="10%" Tag="0.10" Click="HeaderOpacity_OnClick" />
                                    <MenuItem Header="30%" Tag="0.30" Click="HeaderOpacity_OnClick" />
                                    <MenuItem Header="50%" Tag="0.50" Click="HeaderOpacity_OnClick" />
                                    <MenuItem Header="70%" Tag="0.70" Click="HeaderOpacity_OnClick" />
                                    <MenuItem Header="88%" Tag="0.88" Click="HeaderOpacity_OnClick" />
                                    <MenuItem Header="100%" Tag="1.00" Click="HeaderOpacity_OnClick" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Sort items">
                                    <MenuItem Header="Name A-Z" Click="SortNameAscending_OnClick" />
                                    <MenuItem Header="Name Z-A" Click="SortNameDescending_OnClick" />
                                    <MenuItem Header="File type" Click="SortFileType_OnClick" />
                                    <MenuItem Header="Date installed" Click="SortDateInstalled_OnClick" />
                                    <MenuItem Header="Shortcut location" Click="SortShortcutLocation_OnClick" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Reset appearance" Click="ResetAppearance_OnClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="CollapseButton"
                            Width="24"
                            Height="24"
                            Margin="4,0,0,0"
                            Content="{Binding CollapseGlyph}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Collapse"
                            Click="CollapseButton_OnClick" />

                    <Button Grid.Column="3"
                            x:Name="DeleteButton"
                            Width="24"
                            Height="24"
                            Margin="4,0,0,0"
                            Content="x"
                            Style="{StaticResource ToolbarButtonStyle}"
                            ToolTip="Delete capsule"
                            Click="DeleteCapsule_OnClick" />
                </Grid>
            </Border>

            <Grid x:Name="ContentHost" Grid.Row="1" Margin="8,8,8,10">
                <TextBlock x:Name="EmptyHint"
                           Text="Drop shortcuts here"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#7FD6E4F0"
                           FontSize="12"
                           IsHitTestVisible="False" />

                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              CanContentScroll="False">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="68"
                                        MinHeight="66"
                                        Margin="3"
                                        Padding="4"
                                        Background="Transparent"
                                        BorderBrush="{Binding SelectionBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="Item_OnMouseLeftButtonDown"
                                        MouseMove="Item_OnMouseMove"
                                        MouseLeftButtonUp="Item_OnMouseLeftButtonUp">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open" Click="OpenItem_OnClick" />
                                            <MenuItem Header="Open location" Click="OpenLocation_OnClick" />
                                            <MenuItem Header="Restore to desktop" Click="RestoreItem_OnClick" />
                                            <Separator />
                                            <MenuItem Header="Remove from capsule" Click="RemoveItem_OnClick" />
                                        </ContextMenu>
                                    </Border.ContextMenu>

                                    <StackPanel HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               Width="34"
                                               Height="34"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Margin="0,4,0,0"
                                                   Foreground="#F2F7FA"
                                                   FontSize="10"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Thumb x:Name="RightResizeThumb"
                   Grid.RowSpan="2"
                   Panel.ZIndex="2"
                   Width="8"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   DragDelta="RightResizeThumb_OnDragDelta"
                   DragCompleted="ResizeThumb_OnDragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="LeftResizeThumb"
                   Grid.RowSpan="2"
                   Panel.ZIndex="2"
                   Width="8"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Stretch"
                   Cursor="SizeWE"
                   DragDelta="LeftResizeThumb_OnDragDelta"
                   DragCompleted="ResizeThumb_OnDragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="BottomResizeThumb"
                   Grid.RowSpan="2"
                   Panel.ZIndex="2"
                   Height="8"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNS"
                   DragDelta="BottomResizeThumb_OnDragDelta"
                   DragCompleted="ResizeThumb_OnDragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>

            <Thumb x:Name="CornerResizeThumb"
                   Grid.RowSpan="2"
                   Panel.ZIndex="2"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   DragDelta="CornerResizeThumb_OnDragDelta"
                   DragCompleted="ResizeThumb_OnDragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
